[caissa]
farga_url = "http://localhost:7500"
project = "occitan"
pii_patterns = ["email", "phone"]
workspaces_dir = "workspaces"
fondament_path = "../Fondament"
generation = "guilhem"

amassada_url = "http://amassada:7700"

# MCP endpoints injected into agent containers at spawn time.
# Defaults point to cluster-internal DNS (works in kind/EKS/AKS without changes).
# For local dev with kind + port-forward, override to localhost:
#   farga_mcp_url = "http://localhost:7500/mcp"
#   dispatcher_mcp_url = "http://localhost:9090/mcp"
farga_mcp_url = "http://farga.occitan-system.svc.cluster.local:7500/mcp"
dispatcher_mcp_url = "http://dispatcher.agents.svc.cluster.local:9090/mcp"

# registry = "ghcr.io/miegjorn"

# Model overrides (optional — defaults shown).
# chronicle_model = "claude-haiku-4-5-20251001"   # routine observation; cheapest
# matrix_model    = "claude-sonnet-4-6"  # interactive Matrix replies
# dream_model     = "claude-sonnet-4-6"  # nightly dream synthesis; Sonnet is appropriate
#
# For complementary multi-model runs (Anthropic + Grok together, dynamic per-stance/participant):
# set e.g. chronicle_model = "grok-3" or dream_model = "grok-3"
# For full agentic with tools/MCP for Grok, use Amassada canvas with model + endpoint to a Grok service.
# Direct Anthropic path remains for claude* models.
# See dispatch guard in Amassada and model in Fondament definitions.
# The component agent for nervi (and others) will use the default_model from its Fondament def if set.

[sandbox]
image = "caissa-sandbox:latest"
network = "none"
memory_limit = "2g"
# cpu_limit = "1.5"
