# caissa-sandbox:<generation>
# Agent image built by `caissa build <generation>`.
# Layers Claude Code + a baked-in persona on top of caissa-sandbox:latest.
#
# The persona (claude.md) is generated from the Fondament definition at build time
# and placed at ~/.claude/CLAUDE.md — the identity layer that Claude Code reads first.
# Project context from Farga is injected into /workspace/CLAUDE.md at spawn time.
#
# Build: caissa build <generation>
# Run:   caissa spawn <generation> [--project <proj>] [--session <id>]

# Source of the linux caissa binary (built into caissa:latest). Requires caissa:latest
# to be present in the local image store at build time.
FROM ghcr.io/miegjorn/caissa:latest AS caissabin

# trixie (glibc 2.39) to match the caissa binary built on rust:1.90-slim/trixie.
FROM node:20-trixie-slim

# python3 (entrypoint.sh task mode) + git/curl for repo access, and the gh + glab CLIs
# so Guilhem can work against GitHub and GitLab. Tokens are injected at runtime from
# OpenBao (see the guilhem chart initContainer).
ARG GH_VER=2.95.0
ARG GLAB_VER=1.103.0
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends python3 git curl ca-certificates; \
    curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VER}/gh_${GH_VER}_linux_amd64.tar.gz" -o /tmp/gh.tgz; \
    tar -xzf /tmp/gh.tgz -C /tmp; \
    mv "$(find /tmp -type f -name gh -path '*/bin/*' | head -1)" /usr/local/bin/gh; \
    curl -fsSL "https://gitlab.com/gitlab-org/cli/-/releases/v${GLAB_VER}/downloads/glab_${GLAB_VER}_linux_amd64.tar.gz" -o /tmp/glab.tgz; \
    tar -xzf /tmp/glab.tgz -C /tmp; \
    mv "$(find /tmp -type f -name glab | head -1)" /usr/local/bin/glab; \
    chmod +x /usr/local/bin/gh /usr/local/bin/glab; \
    rm -rf /tmp/gh.tgz /tmp/glab.tgz /var/lib/apt/lists/*; \
    git --version; gh --version; glab --version

# Install Claude Code
RUN npm install -g @anthropic-ai/claude-code

# Agent SDK — used by agent-sidecar.js to hold persistent per-room Matrix
# sessions open, instead of spawning a fresh claude --print process per
# message. Installed globally so it's resolvable from /usr/local/bin/agent-sidecar.js
# regardless of cwd.
RUN npm install -g @anthropic-ai/claude-agent-sdk

# The persistent-session sidecar process. listen.rs spawns one instance of
# this per actively-chatting Matrix room.
COPY agent-sidecar.js /usr/local/bin/agent-sidecar.js
RUN chmod +x /usr/local/bin/agent-sidecar.js

# Skills/plugins (e.g. Superpowers) are deliberately NOT baked in yet — doing
# so requires a real decision on how a CI runner (no local ~/.claude/plugins/)
# provisions third-party plugin code at build time. Deferred; sidecar runs
# with skills: [] until that's resolved. See Caissa Farga TODO.

# The caissa binary — Guilhem's pod runs `caissa listen` (the event listener) and
# the binary also drives chronicle runs. Without it the deployment can't start.
COPY --from=caissabin /usr/local/bin/caissa /usr/local/bin/caissa

# Bake the agent persona into the home directory.
# This is the identity layer — who the agent is, not what it knows right now.
RUN mkdir -p /root/.claude
COPY claude.md /root/.claude/CLAUDE.md
# Allow Guilhem to update his own CLAUDE.md (auto-memory / persona reflection).
# Without this, Claude Code's path guard blocks writes to ~/.claude/CLAUDE.md
# even when Edit/Write are listed in --allowed-tools.
RUN printf '{"permissions":{"allow":["Edit(/root/.claude/CLAUDE.md)","Write(/root/.claude/CLAUDE.md)","Edit(/workspace/**)","Write(/workspace/**)"]}}\n' \
    > /root/.claude/settings.json

# Entrypoint script: writes MCP config from env vars, then runs claude.
# MCP servers (farga, dispatcher) are wired at runtime via FARGA_MCP_URL
# and DISPATCHER_MCP_URL — defaults point to cluster-internal DNS.
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Bake Fondament domain + role definitions into the image so agents can
# read them at runtime to assemble context for sub-agent invocations.
# Guilhem reads /fondament/domains/<domain>.yaml and /fondament/roles/<facet>.yaml
# before calling dispatcher.invoke_agent with the assembled context.
COPY fondament_domains/ /fondament/domains/
COPY fondament_roles/ /fondament/roles/

WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
